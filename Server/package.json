{
  "name": "avatar-farm-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@colyseus/ws-transport": "latest",
    "@elysia/cors": "latest",
    "@elysia/node": "latest",
    "colyseus": "latest",
    "dotenv": "latest",
    "drizzle-orm": "^0.45.3",
    "elysia": "latest",
    "jose": "latest",
    "mysql2": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "drizzle-kit": "^0.31.11",
    "tsx": "latest",
    "typescript": "latest"
  }
}
